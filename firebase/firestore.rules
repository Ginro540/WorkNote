rules_version = '2';

// ワークノート Firestore セキュリティルール
// - 従業員は userId が自分のデータだけを読み書きできる
// - 管理者（users/{uid}.role == 'admin'）は全員分を読める
// - settings と sites は全員が読めて、管理者だけが変更できる
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // 作成時：userId が自分で、指定したフィールドだけ
    function createsOwn() {
      return isOwner(request.resource.data.userId);
    }

    // 更新時：userId を変えていない
    function keepsOwner() {
      return request.resource.data.userId == resource.data.userId;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ユーザー
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // アカウントは会社が発行する（アプリからは作れない）。自分の role・email は変更できない
      allow update: if isOwner(uid) && !changedKeys().hasAny(['role', 'email', 'createdAt']);
      allow create, delete: if false;
    }

    // 打刻：本人は追加だけ。時刻は変更・削除できない（あとから位置を追加することだけはできる）
    match /attendancePunches/{punchId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();

      allow create: if createsOwn()
        && request.resource.data.kind in ['in', 'out']
        && request.resource.data.punchedAt is timestamp
        && request.resource.data.receivedAt == request.time
        && request.resource.data.corrected == false
        && request.resource.data.locationStatus in ['pending', 'acquired', 'unavailable', 'denied']
        && request.resource.data.workDate is string
        && request.resource.data.month is string;

      allow update: if isOwner(resource.data.userId)
        && changedKeys().hasOnly(['location', 'locationStatus'])
        && (
          // 取得中の打刻に位置を追加する／取得できなかった・許可されなかったことを記録する
          (resource.data.locationStatus == 'pending'
            && request.resource.data.locationStatus in ['acquired', 'unavailable', 'denied'])
          // 取得済みの位置に住所だけを追加する（緯度・経度は変えない）
          || (resource.data.locationStatus == 'acquired'
            && request.resource.data.locationStatus == 'acquired'
            && request.resource.data.location.lat == resource.data.location.lat
            && request.resource.data.location.lng == resource.data.location.lng
            && request.resource.data.location.locatedAt == resource.data.location.locatedAt)
        );

      allow delete: if false;
    }

    // 打刻の修正申請：本人が作成・取り消し。承認・却下は管理者だけ
    match /attendanceCorrections/{correctionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();

      allow create: if createsOwn()
        && request.resource.data.status == 'pending'
        && request.resource.data.kind in ['missingClockIn', 'missingClockOut', 'wrongTime', 'noBreak']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && !('reviewedBy' in request.resource.data && request.resource.data.reviewedBy != null);

      allow update: if isOwner(resource.data.userId)
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && changedKeys().hasOnly(['status', 'cancelledAt']);

      allow delete: if false;
    }

    // 日報：承認前（下書き・提出済み）なら本人が更新できる
    match /dailyReports/{reportId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();

      allow create: if createsOwn()
        && request.resource.data.status in ['draft', 'submitted'];

      allow update: if isOwner(resource.data.userId) && keepsOwner()
        && resource.data.status in ['draft', 'submitted']
        && request.resource.data.status in ['draft', 'submitted']
        // 提出済みを下書きに戻すことはしない
        && !(resource.data.status == 'submitted' && request.resource.data.status == 'draft');

      // 下書きだけ本人が削除できる
      allow delete: if isOwner(resource.data.userId) && resource.data.status == 'draft';

      // 修正履歴：追加だけ。本人も管理者も変更・削除できない
      match /revisions/{revId} {
        function report() {
          return get(/databases/$(database)/documents/dailyReports/$(reportId)).data;
        }
        allow read: if isOwner(report().userId) || isAdmin();
        allow create: if isOwner(report().userId) && request.resource.data.editedBy == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // 経費：承認前（下書き・申請済み・差し戻し）なら本人が更新・取り消しできる
    match /expenses/{expenseId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();

      allow create: if createsOwn()
        && request.resource.data.status in ['draft', 'submitted'];

      allow update: if isOwner(resource.data.userId) && keepsOwner()
        && resource.data.status in ['draft', 'submitted', 'returned']
        && request.resource.data.status in ['draft', 'submitted'];

      allow delete: if isOwner(resource.data.userId) && resource.data.status in ['draft', 'returned'];
    }

    // 勤務先の一覧
    match /sites/{siteId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // 日報の項目・経費の区分・会社の設定・休日カレンダー
    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
